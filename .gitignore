testem.log
/typings

# ===== Fichiers système =====
.DS_Store
Thumbs.db

# ===== Logs =====
*.log
logs/

# ===== Environnements et secrets =====
# Si vos fichiers environment*.ts contiennent des clés API, mots de passe, etc.,
# décommentez les lignes suivantes pour les ignorer :
# src/environments/environment.ts
# src/environments/environment.prod.ts
# src/environments/environment.*.ts
# Et créez des fichiers .example à la place.

# Fichiers .env (si vous en utilisez)
.env
.env.local
.env.*.local

