# ===== Voir https://docs.github.com/get-started/getting-started-with-git/ignoring-files =====

# ===== Build / compilation =====
/dist
/tmp
/out-tsc
/bazel-out

# ===== Node =====
/node_modules
npm-debug.log
yarn-error.log
yarn-error.log*
package-lock.json   # à commenter si vous voulez le versionner (recommandé)
# yarn.lock         # à commenter si vous utilisez yarn et voulez le versionner

# ===== IDE et éditeurs =====
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

